OPENROUTER_API_KEY=sk-or-...
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Optional: the model new conversations start with, until you pick another in the UI
# DEFAULT_LLM_MODEL=anthropic/claude-sonnet-4.6
# Optional: comfy-gateway in front of your ComfyUI, so Conversar's bot can run workflows there.
# COMFY_DIRECT_URL (ComfyUI itself) is only used when the gateway doesn't answer. Both unset: no runs.
# COMFY_GATEWAY_URL=http://192.168.1.39:8189
# COMFY_DIRECT_URL=http://192.168.1.39:8188
# Optional: minutes a job may run in ComfyUI without a result before it's given up (default 45).
# It counts from when the job starts executing: waiting its turn in the gateway's queue never counts.
# COMFY_JOB_TIMEOUT_MINUTES=45
# Optional: Civitai API key, used to read images shared in Conversar by their Civitai link, and to
# download models and LoRAs from Civitai (many need it).
# CIVITAI_API_KEY=
# Optional: ComfyUI's models folder (the one holding loras, checkpoints and diffusion_models, each
# with a folder per family). Set, the bot can prepare downloads from Civitai into it; each one
# happens only when you accept it in the chat.
# COMFY_MODELS_DIR=C:\comfy-ui\models
# Optional: Claude Code as Conversar's bot, with a Claude subscription (a conversation's "Responde"
# setting). It runs the `claude` CLI with its own configuration folder, so it uses the account
# signed in there, not the one Claude Code uses elsewhere on this PC. Sign in once, in PowerShell:
#   $env:CLAUDE_CONFIG_DIR = "C:\Users\<you>\.claude-prompt-enhancer"; claude auth login
# CLAUDE_CODE_CONFIG_DIR=C:\Users\<you>\.claude-prompt-enhancer
# CLAUDE_CODE_MODEL=opus
# CLAUDE_CODE_COMMAND=claude
# SELF_URL is where its tool calls come back to this app (Start.bat serves it on port 8090).
# SELF_URL=http://127.0.0.1:8090
# Optional: the time zone pages show times in (default Europe/Madrid, the PC's): some browsers report UTC.
# TIME_ZONE=Europe/Madrid
