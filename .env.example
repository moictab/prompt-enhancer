OPENROUTER_API_KEY=sk-or-...
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Optional: model prefilled in the text / vision model fields until you pick another in the UI
# DEFAULT_LLM_MODEL=anthropic/claude-sonnet-4.6
# DEFAULT_VISION_MODEL=anthropic/claude-sonnet-4.6
# Optional: comfy-gateway in front of your ComfyUI, so Conversar's bot can run workflows there.
# COMFY_DIRECT_URL (ComfyUI itself) is only used when the gateway doesn't answer. Both unset: no runs.
# COMFY_GATEWAY_URL=http://192.168.1.39:8189
# COMFY_DIRECT_URL=http://192.168.1.39:8188
